# Copy to .env.production and fill in. NEVER commit .env.production.

# ===== Public address / HTTPS (read by the web container) =====
# :80 = plain HTTP (localhost or a bare IP).  yourdomain.com = automatic HTTPS.
SITE_ADDRESS=:80
# Must exactly match what you type in the browser (used for email links + CORS)
CLIENT_URL=http://localhost
# false for http://..., true for https://...
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== Backend =====
NODE_ENV=production
PORT=5000
API_VERSION=v1

# MongoDB Atlas (free M0). Do NOT use 127.0.0.1 here — inside a container that is the container itself.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ai-placement-coach

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== AI (Gemini) =====
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model names get retired often. Run `docker compose exec backend node scripts/check-ai.js` to confirm.
GEMINI_MODEL=gemini-3.5-flash

# ===== Email (optional — without it, verification/reset emails are not sent) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Placement Coach <no-reply@example.com>"

# ===== Google sign-in (optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
